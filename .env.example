# === Servidor ===
PORT=3000
NODE_ENV=production
APP_URL=http://localhost:3000

# === Seguridad ===
# Genera valores largos y aleatorios propios antes de desplegar a produccion.
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=7d

# === Base de datos ===
# Ruta del archivo SQLite. Se crea automaticamente si no existe.
DATABASE_PATH=./data/alexapi.db

# === Planes y limites ===
FREE_MONTHLY_LIMIT=4000
PREMIUM_MONTHLY_LIMIT=1000000

# === PayPal (boton "Comprar Premium") ===
PAYPAL_BUSINESS_EMAIL=l29472954@gmail.com

# === Proveedor de IA (opcional) ===
# Los endpoints /api/ai/* estan preparados pero DESACTIVADOS hasta que
# configures una clave real aqui. No se incluye ninguna clave de ejemplo.
# Soporta "openai" o "anthropic" como valor de AI_PROVIDER.
AI_PROVIDER=
AI_PROVIDER_API_KEY=

# === Correo (para recuperar contrasena) ===
# Sin estas variables, el sistema seguira funcionando pero el enlace de
# recuperacion se devolvera en la respuesta de la API en vez de enviarse
# por correo (modo desarrollo). Configura un proveedor real en produccion.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@alexapi.dev

# === Descargas (/api/download/*) ===
# Requiere el binario "yt-dlp" instalado en el servidor (ver Dockerfile).
# Solo cambia esto si tu binario no esta en el PATH del sistema.
YTDLP_PATH=yt-dlp
